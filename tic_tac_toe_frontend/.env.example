# Frontend environment variables for Tic Tac Toe (React)
# IMPORTANT: Variables are embedded at build/start time. After changing them, restart dev server or rebuild.

# Base URL for the backend API.
# For local development, keep it as http://localhost:3001
# For preview or production, set to the backend preview URL (e.g., https://<your-preview-host>:3001)
REACT_APP_API_BASE=http://localhost:3001

# Optional additional vars (not required by this app but supported by infra/tools)
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=true
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/healthz
REACT_APP_FEATURE_FLAGS={}
REACT_APP_EXPERIMENTS_ENABLED=false
