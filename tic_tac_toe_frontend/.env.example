# PUBLIC INTERFACE
# Backend base URL used by the frontend to call the API.
# IMPORTANT: Must be a full origin (protocol + host + optional port), no trailing slash.
# In preview/staging, set this to the backend preview origin exactly.
#
# Examples:
# - Local:           http://localhost:3001
# - Preview (HTTP):  http://vscode-internal-20447-beta.beta01.cloud.kavia.ai:3001
# - Preview (HTTPS): https://vscode-internal-20447-beta.beta01.cloud.kavia.ai:3001
#
# The app will first check REACT_APP_API_BASE, then REACT_APP_BACKEND_URL. If neither is set,
# it falls back to http://localhost:3001.
REACT_APP_API_BASE=http://localhost:3001
# Alternatively:
# REACT_APP_BACKEND_URL=http://localhost:3001
